# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model id from https://openrouter.ai/models, pick one tagged "free" to run at no cost.
# Falls back to minimax/minimax-m3:free if left blank, the fastest and most reliable free
# model we benchmarked for this task's structured-JSON output.
OPENROUTER_MODEL=

HF_TOKEN=  # optional — get a free one at huggingface.co/settings/tokens, raises your rate limit on the Space. Works without it too.
